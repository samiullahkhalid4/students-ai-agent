{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "{server/db/schema.sql,node_modules/pdf-parse/dist/**,node_modules/@napi-rs/canvas*/**,node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ]
}
