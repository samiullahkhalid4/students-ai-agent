{
  "name": "smart-study-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,blue \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "test:e2e": "playwright test",
    "test:live": "node scripts/verify-live.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.56.0"
  }
}
