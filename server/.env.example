# Copy this file to server/.env. Never place API keys in client/ or VITE_* variables.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3001
HOST=127.0.0.1
# Relative to server/ (absolute paths also work).
DATABASE_PATH=./db/study.sqlite
# Vercel only: use a persistent hosted SQLite database, not DATABASE_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
